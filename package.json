{
  "name": "mehan-design-system-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Mehan Design System — Universal tactile UI system powered by Meta Astryx and Mehan Portable.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @mehan/dna build && pnpm --filter @mehan/astryx build && pnpm --filter @mehan/portable build && pnpm --filter @mehan/studio build",
    "dev": "pnpm --filter @mehan/studio dev",
    "studio": "pnpm --filter @mehan/studio build:singlefile",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "verify:astryx": "pnpm --filter @mehan/astryx verify",
    "verify:visual": "playwright test",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm verify:astryx && pnpm verify:visual",
    "init-project": "node bin/mehan.mjs init"
  },
  "browserslist": [
    "Chrome >= 123",
    "Firefox >= 120",
    "Safari >= 17.5"
  ],
  "devDependencies": {
    "@astryxdesign/build": "0.7.17",
    "@astryxdesign/cli": "0.7.17",
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/figtree": "^5.2.5",
    "@fontsource/geist-mono": "^5.2.5",
    "@playwright/test": "^1.52.0",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.66.0",
    "playwright": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.1.3"
  }
}
