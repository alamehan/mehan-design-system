{
  "name": "@mehan/dna",
  "version": "1.0.0",
  "description": "Single-source tactile material, perceptual OKLCH palette, atmosphere, and token engine for Mehan Design System.",
  "license": "MIT",
  "homepage": "https://github.com/alamehan/mehan-design-system/tree/main/packages/dna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alamehan/mehan-design-system.git",
    "directory": "packages/dna"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  }
}
